# ─── Binance API ─────────────────────────────────────────────────────────────
BINANCE_API_KEY=YOUR_API_KEY_HERE
BINANCE_SECRET_KEY=YOUR_SECRET_KEY_HERE

# true = testnet, false = mainnet (GERÇEK PARA)
BINANCE_TESTNET=true

# ─── Trading ─────────────────────────────────────────────────────────────────
# Kaldıraç (1-125)
LEVERAGE=5

# Aynı anda maksimum açık pozisyon sayısı
MAX_OPEN_POSITIONS=5

# İşlem başına risk yüzdesi (1.0 = bakiyenin %1'i)
RISK_PER_TRADE_PCT=1.0

# Sinyal skoru eşiği — bu değerin üzerinde işlem açılır (0-100)
MIN_SCORE_TO_OPEN=65.0

# İşlem açmak için gereken minimum USDT bakiye
MIN_BALANCE_USDT=50.0

# ─── Risk ────────────────────────────────────────────────────────────────────
# Günlük maksimum kayıp yüzdesi (5.0 = bakiyenin %5'i)
DAILY_LOSS_LIMIT_PCT=5.0

# Stop Loss — ATR çarpanı (1.5 × ATR mesafesi)
SL_ATR_MULTIPLIER=1.5

# Take Profit — ATR çarpanı (3.0 × ATR mesafesi)  
TP_ATR_MULTIPLIER=3.0

# Trailing stop: true/false
TRAILING_STOP=false

# ─── Semboller ───────────────────────────────────────────────────────────────
# En yüksek hacimli kaç sembolü tara
TOP_SYMBOLS_COUNT=20

# Kara liste (virgülle ayrılmış, örn: LUNAUSDT,USTCUSDT)
BLACKLIST=

# ─── Zaman Dilimleri ─────────────────────────────────────────────────────────
# Ana sinyal zaman dilimi
PRIMARY_TF=15m

# Konfirmasyon zaman dilimi
HIGHER_TF=1h

# Her sembol için kaç mum indirilsin
KLINE_LIMIT=300

# ─── ML Modeli ───────────────────────────────────────────────────────────────
# Kaç saatte bir modeli yeniden eğit
ML_RETRAIN_HOURS=4

# Eğitim için kaç geçmiş mum kullan
ML_HISTORY_CANDLES=500

# ─── Telegram ────────────────────────────────────────────────────────────────
# @BotFather'dan al
TELEGRAM_BOT_TOKEN=

# Kanalın veya hesabının Chat ID'si
TELEGRAM_CHAT_ID=

# ─── Dashboard ───────────────────────────────────────────────────────────────
# 0.0.0.0 = dışarıdan erişilebilir (VPS için), 127.0.0.1 = sadece lokal
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# ─── Veritabanı ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./trading_bot.db

# ─── Zamanlama ───────────────────────────────────────────────────────────────
# Kaç saniyeden eski veri "stale" sayılır
STALE_DATA_SECONDS=120

# Pozisyon kontrol aralığı (saniye)
POSITION_CHECK_INTERVAL=30

# Listen key yenileme sıklığı (dakika)
LISTEN_KEY_REFRESH_MINUTES=45
